[Unit]
Description=Check that the mergerfs media pool is mounted, remount if not
After=network.target

[Service]
Type=oneshot
ExecStart=/home/server/docker/comics-manga/mergerfs-watchdog.sh
User=root
# Belt-and-suspenders on top of the script's own internal `timeout` calls -
# a run should never take anywhere near this long once those work, but this
# caps it so the timer can never again silently stack multi-minute runs.
TimeoutStartSec=30
